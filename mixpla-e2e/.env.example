# Target environment (optional; defaults to https://mixpla.io)
BASE_URL=https://mixpla.io

# QA test submitter identity: an email plus its one-time code. Uses the QA OTP
# bypass pair (OtpService.TEST_BYPASS_EMAIL / TEST_BYPASS_CODE in datanest),
# which verifies without sending a real email. Used by both the track
# submission test and the Mixdeck login/language/logout test.
MIXDECK_TEST_USER=qa-test@mixpla.io
MIXDECK_TEST_OTP=424242
